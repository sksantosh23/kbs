---
import darkLogo from '../assets/brand/kora-logo-on-dark.svg';
import lightLogo from '../assets/brand/kora-logo-on-light.svg';
interface Props { large?: boolean; variant?: 'dark' | 'light' }
const { large = false, variant = 'dark' } = Astro.props;
---
<img class:list={['brand-logo', { 'brand-large': large }]} src={variant === 'light' ? lightLogo.src : darkLogo.src} alt="Kora Business Solutions" width="508" height="212" />
<style>.brand-logo{display:block;width:176px;height:auto;object-fit:contain}.brand-large{width:230px}@media(max-width:767px){.brand-logo{width:155px}.brand-large{width:205px}}</style>
