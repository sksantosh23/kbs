---
import type { EditorialMedia } from '../content/media';
interface Props { image: EditorialMedia; caption?: string; eager?: boolean; class?: string }
const { image, caption, eager = false, class: className } = Astro.props;
---
<figure class:list={['editorial-image', className]}>
  <picture>
    <source srcset={image.avif} type="image/avif" />
    <source srcset={image.webp} type="image/webp" />
    <img src={image.fallback.src} alt={image.alt} width={image.width} height={image.height} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} sizes="(max-width: 767px) 100vw, 50vw" />
  </picture>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>.editorial-image{margin:0}.editorial-image picture,.editorial-image img{display:block;width:100%}.editorial-image img{height:auto;aspect-ratio:4/3;object-fit:cover}.editorial-image figcaption{margin-top:10px;font-size:10px;letter-spacing:.04em;color:var(--muted)}
</style>
