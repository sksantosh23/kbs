---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getDb } from '../../server/database';
import { verifyPassword, createSession, consumeRateLimit } from '../../server/auth';
import { createHash } from 'node:crypto';
export const prerender = false;
let error = '';
if (Astro.request.method === 'POST') {
  const body = await Astro.request.formData(); const username=String(body.get('username')||''); const password=String(body.get('password')||'');
  const bucket=createHash('sha256').update(`login|${username.toLowerCase()}|${Astro.clientAddress||'unknown'}`).digest('hex').slice(0,24);
  const allowed=consumeRateLimit(bucket);
  const row=allowed ? getDb().prepare('SELECT * FROM admins WHERE username=? AND active=1').get(username) as any : null;
  if(allowed && row && await verifyPassword(password,row.password_hash)) { const session=createSession(row.id); Astro.cookies.set('kora_session',session.token,{httpOnly:true,secure:import.meta.env.PROD,sameSite:'lax',path:'/',maxAge:28800}); Astro.cookies.set('kora_csrf',session.csrf,{httpOnly:false,secure:import.meta.env.PROD,sameSite:'lax',path:'/',maxAge:28800}); return Astro.redirect('/admin/inquiries'); }
  error='Sign-in could not be completed.';
}
---
<SiteLayout title="Admin sign in"><section class="section"><div class="wrap reading"><p class="eyebrow">PRIVATE / ADMIN</p><h1>Sign in.</h1>{error && <p class="inline-notice" role="alert">{error}</p>}<form method="post" class="admin-form"><label>Username<input name="username" required autocomplete="username"/></label><label>Password<input name="password" type="password" required autocomplete="current-password"/></label><button class="button" type="submit">Sign in ↗</button></form></div></section></SiteLayout>
<style>.admin-form{max-width:480px;display:grid;gap:20px}.admin-form label{display:grid;gap:8px;font-size:12px}.admin-form input{padding:14px;border:1px solid var(--line);background:var(--paper);font:inherit}</style>
