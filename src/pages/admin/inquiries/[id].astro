---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getSession, csrfMatches } from '../../../server/auth';
import { getInquiry, updateStatus, addNote } from '../../../application/inquiries';
export const prerender = false;
const session=getSession(Astro.cookies.get('kora_session')?.value); if(!session) return Astro.redirect('/admin/login');
const id=Astro.params.id!;
if(Astro.request.method==='POST'){const body=await Astro.request.formData(); if(!csrfMatches(session.csrf, String(body.get('csrf')||''))) return new Response('Forbidden',{status:403}); const action=String(body.get('action')||''); if(action==='status') updateStatus(id,String(body.get('status')) as any,session.admin_id); if(action==='note') addNote(id,session.admin_id,String(body.get('note')||'')); return Astro.redirect(`/admin/inquiries/${id}`)}
const row=getInquiry(id); if(!row) return Astro.redirect('/admin/inquiries');
---
<SiteLayout title={`Inquiry ${row.public_reference}`}><section class="section"><div class="wrap reading"><a href="/admin/inquiries">← Inquiry inbox</a><p class="eyebrow">{row.type} / {row.routing_queue}</p><h1>{row.public_reference}</h1><p><strong>{row.contact_name}</strong> · <a href={`mailto:${row.email}`}>{row.email}</a>{row.organization && ` · ${row.organization}`}</p><div class="detail"><h2>{row.subject}</h2><p>{row.details}</p><pre>{JSON.stringify(row.structured_data,null,2)}</pre></div><form method="post" class="admin-form"><input type="hidden" name="csrf" value={session.csrf}/><input type="hidden" name="action" value="status"/><label>Status<select name="status"><option value="IN_REVIEW">IN_REVIEW</option><option value="CONTACTED">CONTACTED</option><option value="CLOSED">CLOSED</option><option value="SPAM">SPAM</option></select></label><button class="button" type="submit">Update status</button></form><form method="post" class="admin-form"><input type="hidden" name="csrf" value={session.csrf}/><input type="hidden" name="action" value="note"/><label>Internal note<textarea name="note" maxlength="5000" required></textarea></label><button class="button button-outline" type="submit">Add note</button></form></div></section></SiteLayout>
<style>.detail{border:1px solid var(--line);padding:24px;margin:30px 0}.detail pre{white-space:pre-wrap;background:var(--stone);padding:16px;font-size:12px}.admin-form{display:grid;gap:12px;max-width:520px;margin-top:24px}.admin-form label{display:grid;gap:8px;font-size:12px}.admin-form select,.admin-form textarea{padding:12px;border:1px solid var(--line);font:inherit}</style>
