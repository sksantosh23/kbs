---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getSession } from '../../../server/auth';
import { listInquiries } from '../../../application/inquiries';
import { inquiryTypes } from '../../../domain/inquiry';
export const prerender = false;
const session=getSession(Astro.cookies.get('kora_session')?.value); if(!session) return Astro.redirect('/admin/login');
const filters={type:Astro.url.searchParams.get('type')||undefined,routing_queue:Astro.url.searchParams.get('routing_queue')||undefined,status:Astro.url.searchParams.get('status')||undefined,q:Astro.url.searchParams.get('q')||undefined};
const rows=listInquiries(filters);
---
<SiteLayout title="Inquiry inbox"><section class="section"><div class="wrap"><p class="eyebrow">PRIVATE / INQUIRIES</p><div class="admin-head"><h1>Inquiry inbox</h1><form class="filters" role="search"><label>Search<input name="q" value={filters.q} placeholder="Reference, contact or email" maxlength="200"/></label><label>Type<select name="type"><option value="">All types</option>{inquiryTypes.map(type=><option value={type} selected={filters.type===type}>{type}</option>)}</select></label><label>Queue<select name="routing_queue"><option value="">All queues</option>{['GENERAL','PROCUREMENT','CONTRACTS'].map(queue=><option value={queue} selected={filters.routing_queue===queue}>{queue}</option>)}</select></label><label>Status<select name="status"><option value="">All status</option>{['NEW','IN_REVIEW','CONTACTED','CLOSED','SPAM'].map(s=><option value={s} selected={filters.status===s}>{s}</option>)}</select></label><button class="button button-outline">Filter</button></form><form method="post" action="/admin/export"><input type="hidden" name="csrf" value={session.csrf}/><input type="hidden" name="type" value={filters.type||''}/><input type="hidden" name="routing_queue" value={filters.routing_queue||''}/><input type="hidden" name="status" value={filters.status||''}/><input type="hidden" name="q" value={filters.q||''}/><button class="button button-outline" type="submit">Export CSV</button></form></div><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Type</th><th>Queue</th><th>Contact</th><th>Status</th><th>Date</th></tr></thead><tbody>{rows.map((row:any)=><tr><td><a href={`/admin/inquiries/${row.id}`}>{row.public_reference}</a></td><td>{row.type}</td><td>{row.routing_queue}</td><td>{row.contact_name}</td><td>{row.status}</td><td>{new Date(row.created_at).toLocaleDateString()}</td></tr>)}{!rows.length&&<tr><td colspan="6">No inquiries found.</td></tr>}</tbody></table></div></div></section></SiteLayout>
<style>.admin-head{display:flex;justify-content:space-between;align-items:center;gap:20px}.admin-head form{display:flex;gap:8px}.admin-head select{padding:10px;border:1px solid var(--line);background:var(--paper)}.table-wrap{overflow:auto;margin-top:30px}table{width:100%;border-collapse:collapse;font-size:13px}th,td{text-align:left;padding:14px;border-bottom:1px solid var(--line);white-space:nowrap}@media(max-width:700px){.admin-head{display:block}.admin-head form{margin-top:16px}}</style>
