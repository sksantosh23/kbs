---
import SiteLayout from '../layouts/SiteLayout.astro';
import { contacts } from '../content/site';
---
<SiteLayout title="Contact Kora"><section class="section"><div class="wrap"><p class="eyebrow">CONTACT</p><h1>Choose the right conversation.</h1><div class="contact-grid"><article><h2>General</h2><p>Questions, privacy and accessibility concerns.</p><a href={`mailto:${contacts.general}`}>{contacts.general} ↗</a></article><article><h2>Procurement</h2><p>Sourcing, suppliers and RFQ/RFI-oriented requirements.</p><a href={`mailto:${contacts.procurement}`}>{contacts.procurement} ↗</a></article><article><h2>Contracts</h2><p>Government contracting, teaming and contract paths.</p><a href={`mailto:${contacts.contracts}`}>{contacts.contracts} ↗</a></article></div><p class="contact-details"><a href={contacts.phoneHref}>{contacts.phone}</a><br/>{contacts.location}</p><a class="button" href="/request">Send a general inquiry ↗</a></div></section></SiteLayout>
<style>.contact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);margin:55px 0}.contact-grid article{background:var(--paper);padding:28px;min-height:220px}.contact-grid h2{font-size:26px}.contact-grid p{color:var(--muted);min-height:60px}.contact-grid a{font-size:13px}.contact-details{line-height:1.8;margin-bottom:28px}@media(max-width:700px){.contact-grid{grid-template-columns:1fr;margin:30px 0}.contact-grid article{min-height:auto}}</style>
