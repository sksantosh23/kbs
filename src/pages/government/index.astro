---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { contacts, capabilities, site } from '../../content/site';
---
<SiteLayout title="Government & Public Sector"><section class="section section-dark"><div class="wrap"><p class="eyebrow">{site.status}</p><h1>A clear path into public-sector work.</h1><p class="lead">Kora Business Solutions supports public-sector buyers and partners with sourcing, supply, technology, service, logistics and contracting conversations.</p><div class="actions"><a class="button" href="/request?type=government">Submit Government Requirement ↗</a><a class="text-link" href="/government/contracting">Government contracting ↗</a></div></div></section><section class="section"><div class="wrap"><div class="section-heading"><h2>Approved capability areas</h2><p>Public descriptions stay factual and business-focused. Detailed capability publication requires internal source approval.</p></div><div class="capability-list">{capabilities.map(c=><a class="capability-row" href={`/what-we-do/${c.slug}`}><span class="number">↗</span><h3>{c.title}</h3><p>{c.description}</p></a>)}</div></div></section><section class="section section-stone"><div class="wrap two-col"><div><p class="eyebrow">HOW TO ENGAGE KORA</p><h2>Bring the opportunity and the path.</h2></div><div><p>Use the structured form for RFQ, RFP, RFI, RFC, fixed-price/FFP, solicitation, contract, subcontracting, teaming or another public-sector requirement.</p><p><a href={`mailto:${contacts.procurement}`}>{contacts.procurement} ↗</a><br/><a href={`mailto:${contacts.contracts}`}>{contacts.contracts} ↗</a><br/>{contacts.location}</p></div></div></section></SiteLayout>
<style>.lead{font-size:20px;max-width:680px;color:#c3c8ba}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:80px}.two-col p{line-height:1.7}@media(max-width:700px){.two-col{grid-template-columns:1fr;gap:24px}}</style>
