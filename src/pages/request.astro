---
import SiteLayout from '../layouts/SiteLayout.astro';
import { inquiryTypes, typeLabels } from '../domain/inquiry';
const type = Astro.url.searchParams.get('type') || '';
const selected = ({product:'PRODUCT',medical:'MEDICAL_TECHNOLOGY',iot:'IOT_CONNECTED_SYSTEMS',government:'GOVERNMENT'} as Record<string,string>)[type] || type;
---
<SiteLayout title="Start a Requirement" description="Describe the requirement and the outcome you need to move toward.">
  <section class="section"><div class="wrap form-shell"><div class="section-heading"><div><p class="eyebrow">START A REQUIREMENT</p><h1>Describe what needs to move.</h1></div><p>Share only business-level information. Do not submit classified, CUI, export-controlled, payment, patient, credential, secret, or other regulated sensitive information.</p></div>
  <form method="post" action="/api/inquiries" class="intake-form" data-intake-form>
    <input type="hidden" name="type" value={selected}/>
    <div class="form-step"><label for="type-select">What kind of requirement is this?</label><select id="type-select" name="type_display" data-type-select required><option value="">Choose one</option>{inquiryTypes.filter(t=>t!=='GENERAL'&&t!=='SUPPLIER'&&t!=='TEAMING').map(t=><option value={t} selected={selected===t}>{typeLabels[t]}</option>)}<option value="OTHER" selected={selected==='OTHER'}>Other</option></select></div>
    <div class="form-grid"><label>Contact name<input name="contact_name" required maxlength="150" autocomplete="name"/></label><label>Email<input name="email" required maxlength="254" type="email" autocomplete="email"/></label><label>Organization (optional)<input name="organization" maxlength="200" autocomplete="organization"/></label><label>Phone (optional)<input name="phone" maxlength="50" autocomplete="tel"/></label><label class="wide">Requirement title<input name="subject" maxlength="200"/></label><label class="wide">Requirement summary / message<textarea name="details" required maxlength="10000" rows="7"></textarea></label></div>
    <div class="form-specific" data-specific></div>
    <label class="consent"><input type="checkbox" required/> I understand this is a business inquiry and have reviewed the <a href="/privacy">privacy notice</a>.</label>
    <div class="warning inline-notice"><strong>Keep sensitive information out.</strong> This form is not approved for PHI, patient records, passwords, API keys, private network details, CUI, export-controlled information, financial account data, SSNs, or payment-card data.</div>
    <button class="button" type="submit">Send requirement <span aria-hidden="true">↗</span></button>
  </form></div></section>
</SiteLayout>
<script>/* @ts-nocheck */
const form=document.querySelector('[data-intake-form]') as HTMLFormElement | null; const select=form?.querySelector('[data-type-select]') as HTMLSelectElement | null; const target=form?.querySelector('[data-specific]') as HTMLElement | null;
const fields: Record<string,string[][]>={GOVERNMENT:[['acquisition_type','Acquisition / opportunity type','select'],['due_date','Response / due date (if applicable)','date']],IOT_CONNECTED_SYSTEMS:[['device_context','Device / system context','textarea'],['desired_outcome','Desired outcome','textarea']],SERVICE:[['timing','Desired start / timing','text']],LOGISTICS:[['timing','Desired timing','text']],TECHNOLOGY:[['desired_outcome','Desired outcome','textarea']]};
function render(){if(!target||!select)return; target.innerHTML=''; for(const [name,label,kind] of (fields[select.value]||[])){const l=document.createElement('label');l.textContent=label;const c:any=document.createElement(kind==='textarea'?'textarea':'input');c.name=name;c.required=true;c.maxLength=2000;if(kind==='date')c.type='date';l.append(c);target.append(l)}}
select?.addEventListener('change',()=>{const hidden=form?.querySelector('input[name="type"]') as HTMLInputElement | null; if(hidden && select) hidden.value=select.value; render()}); render();
</script>
<style>.form-shell{max-width:980px}.form-shell .section-heading{grid-template-columns:1fr .7fr}.intake-form{border-top:1px solid var(--line);padding-top:30px;display:grid;gap:24px}.intake-form label{display:grid;gap:8px;font-size:12px;letter-spacing:.04em}.intake-form input,.intake-form textarea,.intake-form select{font:inherit;border:1px solid var(--line);background:var(--paper);padding:14px;min-height:48px;color:var(--ink)}.form-grid,.form-specific{display:grid;grid-template-columns:1fr 1fr;gap:20px}.form-grid .wide,.form-specific .wide{grid-column:1/-1}.form-specific:empty{display:none}.consent{display:flex!important;align-items:center;gap:10px}.consent input{min-height:20px}.inline-notice{padding:16px;background:var(--stone);font-size:13px}@media(max-width:700px){.form-shell .section-heading{display:block}.form-grid,.form-specific{grid-template-columns:1fr}.form-grid .wide{grid-column:auto}}</style>
