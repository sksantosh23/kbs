---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import PreviewNotice from '../components/PreviewNotice.astro';
import FinalCTA from '../components/FinalCTA.astro';
import {productCategories} from '../content/site';
---
<SiteLayout title="Products & Sourcing Categories"><PageHero eyebrow="Products" title="Start with what you need to source." description="Explore product categories to help frame your requirement. Bring a specification, a use case, or a question."/><section class="section section-stone"><div class="wrap"><PreviewNotice/><p class="directory-note">This is a sourcing-capability directory. Categories do not guarantee current inventory, price, lead time, or manufacturer authorization. The proposed categories below require approval before publication.</p><form id="product-search" role="search" class="search-form"><label for="category-query">Find a sourcing category</label><div><input type="search" id="category-query" name="q" placeholder="Try industrial, packaging, or connected devices" autocomplete="off"/><button type="reset" class="button button-ink">Clear search</button></div></form><p id="search-status" role="status" aria-live="polite" aria-atomic="true">{productCategories.length} categories</p><div class="product-grid">{productCategories.map((category,index) => <article class="product-card" data-category={`${category.title} ${category.description}`.toLowerCase()}><span class="eyebrow">{String(index+1).padStart(2,'0')} / SOURCING CATEGORY</span><h2>{category.title}</h2><p>{category.description}</p><a href="/request?type=product" aria-label={`Discuss a ${category.title} sourcing requirement`}>Discuss your requirement <span aria-hidden="true">↗</span></a></article>)}</div><div id="no-results" hidden><h2>No matching category.</h2><p>A category search can’t cover every requirement. Kora may still be able to help you explore a sourcing path.</p><a class="button" href="/request?type=product">Tell us what you need <span aria-hidden="true">↗</span></a></div><noscript><p>All categories are shown. Use your browser’s Find command to search this page.</p></noscript><div class="actions"><a class="text-link" href="/what-we-do/sourcing-procurement">Sourcing & Procurement ↗</a><a class="text-link" href="/government">Government & Public Sector ↗</a></div></div></section><FinalCTA href="/request?type=product" title="The right category starts with your requirement." label="Tell us what you need"/></SiteLayout>
<script is:inline src="/scripts/product-search.js"></script><style>.directory-note{max-width:850px;font-size:14px;color:var(--muted);margin-bottom:36px}.search-form{max-width:850px}.search-form label{display:block;font-weight:600;margin-bottom:12px}.search-form>div{display:flex;gap:12px}.search-form input{flex:1;min-width:0}#search-status{font-size:12px;color:var(--muted);margin:22px 0}.product-grid{display:grid;grid-template-columns:repeat(3,1fr);border-left:1px solid var(--line);border-top:1px solid var(--line)}.product-card{padding:30px;display:flex;flex-direction:column;align-items:flex-start;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--paper)}.product-card>.eyebrow{font-size:9px;color:var(--muted);margin-bottom:32px}.product-card h2{font-size:26px;letter-spacing:-.8px}.product-card p{font-size:14px;color:var(--muted);margin-bottom:28px}.product-card a{margin-top:auto;padding-block:10px;border-bottom:1px solid var(--ink);font-size:12px;display:flex;justify-content:space-between;gap:22px;min-height:44px}#no-results{padding:50px;border:1px solid var(--line);background:var(--paper)}#no-results h2{font-size:32px}#no-results p{max-width:600px}@media(max-width:1000px){.product-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.product-grid{grid-template-columns:1fr}.search-form>div{flex-direction:column}.search-form input{width:100%}.search-form .button{align-self:flex-start}.product-card{padding:25px}.product-card>.eyebrow{margin-bottom:23px}#no-results{padding:25px}}</style>
