---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PreviewNotice from '../../components/PreviewNotice.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import {capabilities} from '../../content/site';
export function getStaticPaths(){return capabilities.map(capability => ({params:{slug:capability.slug},props:{capability}}));}
export const prerender = true;
const {capability} = Astro.props;
---
<SiteLayout title={capability.title} description={capability.description}><PageHero eyebrow={capability.title} title={capability.prompt} description={capability.description} parent={{label:'What We Do',href:'/what-we-do'}}><a class="button" href={`/request?type=${capability.type}`}>Start a {capability.type === 'product' ? 'sourcing' : capability.type} requirement <span aria-hidden="true">↗</span></a></PageHero><section class="section section-stone"><div class="wrap"><PreviewNotice/><div class="prose-columns"><div><p class="eyebrow">01 / FRAME THE NEED</p><h2>What might your requirement look like?</h2><ul>{capability.examples.map(example => <li>{example}</li>)}</ul>{capability.type === 'medical' && <p>Keep this a business inquiry. Do not include patient information, clinical records, or patient-specific questions. This website does not provide medical advice.</p>}{capability.type === 'iot' && <p>Describe systems at a high level. Do not share credentials, secret keys, or sensitive network-access information.</p>}</div><div><p class="eyebrow">02 / DEFINE THE ROLE</p><h2>A focused next conversation.</h2><p>{capability.role}</p><p>Proposed discussion sequence: describe the requirement, review the scope, clarify the constraints, and confirm any next steps. A submission does not confirm acceptance or delivery.</p></div></div></div></section><section class="section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">03 / CONNECTED CAPABILITIES</p><h2>Consider what connects.</h2></div><p>Requirements rarely stop at a single category. These are useful places to continue exploring.</p></div><div class="capability-list">{capabilities.filter(item => capability.related.includes(item.slug)).map(item => <a class="capability-row" href={`/what-we-do/${item.slug}`}><span class="number">↳</span><h3>{item.title}</h3><p>{item.description}</p><span class="arrow" aria-hidden="true">↗</span></a>)}</div><div class="actions"><a class="text-link" href="/products">Product sourcing categories ↗</a><a class="text-link" href="/government">Government requirements ↗</a><a class="text-link" href="/partners">Partner pathways ↗</a></div></div></section><FinalCTA href={`/request?type=${capability.type}`} title="Give your requirement a starting point."/></SiteLayout>
