---
import SiteLayout from '../layouts/SiteLayout.astro';
import FinalCTA from '../components/FinalCTA.astro';
import PreviewNotice from '../components/PreviewNotice.astro';
import { capabilities, contacts } from '../content/site';
const launchers = [['Product / Sourcing','product'],['Medical & Invasive Technologies','medical'],['IoT & Connected Systems','iot'],['Service','service'],['Logistics','logistics'],['Technology Enablement','technology'],['Government / Public Sector','government'],['Other','other']];
---
<SiteLayout title="What do you need solved?">
<section class="home-hero"><div class="wrap hero-grid"><div class="hero-copy"><div class="eyebrow section-label"><span class="signal-dot"></span>REQUIREMENT → CONNECTION → EXECUTION</div><h1>What do you<br/>need <span>solved?</span></h1><p>Kora connects your business requirements to the products, people, and pathways that move them forward.</p><div class="actions"><a class="button" href="/request">Start a Requirement <span aria-hidden="true">↗</span></a><a class="hero-secondary" href="/what-we-do">Explore what we do <span aria-hidden="true">↗</span></a></div><a class="hero-government" href="/government"><span class="signal-dot"></span>Government & Public Sector <span aria-hidden="true">↗</span></a></div><div class="hero-art" aria-hidden="true"><div class="art-top"><span>EVERY REQUIREMENT HAS A PATH.</span><span>K / 01</span></div><svg viewBox="0 0 560 540" fill="none"><defs><pattern id="grid" width="35" height="35" patternUnits="userSpaceOnUse"><path d="M35 0H0V35" stroke="#41433b" stroke-width=".5"/></pattern></defs><rect width="560" height="540" fill="url(#grid)"/><path d="M45 113H173L324 264H524" stroke="#777c6b" stroke-width="2"/><path d="M44 427H171L326 270" stroke="#777c6b" stroke-width="2"/><path d="M173 0V136L307 270L173 404V540" stroke="#777c6b" stroke-width="2"/><path d="M235 25V188L400 25H522L279 269L523 515H400L235 353V515H124V25H235Z" fill="#ff5a36"/><path d="M235 188L279 231V309L235 353" fill="#101111" fill-opacity=".18"/><circle cx="45" cy="113" r="7" fill="#b9d8b0"/><circle cx="44" cy="427" r="7" fill="#b9d8b0"/><circle cx="523" cy="269" r="7" fill="#faf9f5"/><path d="M0 269H560" stroke="#d4d7cb" stroke-width=".5" stroke-dasharray="3 7"/></svg><div class="art-bottom"><span>DEFINE THE NEED.</span><span>CONNECT THE POSSIBILITIES. ↗</span></div></div></div><div class="hero-baseline wrap"><span>BUSINESS SOLUTIONS. CONNECTED.</span><span>Sourcing · Services · Systems · Supply</span><a href="#possibilities">Explore the possibilities <span aria-hidden="true">↓</span></a></div></section>
<section class="launcher-section" id="possibilities"><div class="wrap"><div class="launcher-heading"><p class="eyebrow">01 / START WITH YOUR NEED</p><h2>A starting point.<br/>Not a limitation.</h2><p>You don’t need to know every detail.<br/>Choose a direction. Tell us what matters.</p></div><div class="launcher-grid">{launchers.map(([label,type],index) => <a href={`/request?type=${type}`}><span class="eyebrow">0{index+1}</span><span>{label}</span><span aria-hidden="true">↗</span></a>)}</div></div></section>
<section class="section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">02 / WHAT WE DO</p><h2>One requirement.<br/>Connected possibilities.</h2></div><p>A sourcing need may involve supply, technology, and coordination. Explore the connected areas that can shape a requirement.</p></div><PreviewNotice/><div class="capability-list">{capabilities.map((item,index) => <a class="capability-row" href={`/what-we-do/${item.slug}`}><span class="number">0{index+1} /</span><h3>{item.title}</h3><p>{item.description}</p><span class="arrow" aria-hidden="true">↗</span></a>)}<a class="capability-row" href="/partners"><span class="number">08 /</span><h3>Strategic Partnerships</h3><p>Open a conversation about supplier relationships, teaming, and delivery.</p><span class="arrow" aria-hidden="true">↗</span></a></div></div></section>
<section class="section section-stone"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">03 / HOW KORA WORKS</p><h2>From “what if”<br/>to what’s next.</h2></div><p>A proposed framework for turning a need into a focused conversation, then defining a practical path forward. Each engagement begins with scope review.</p></div><ol class="process"><li><span>01</span><h3>Requirement</h3><p>Describe the need and the outcome you’re working toward.</p></li><li><span>02</span><h3>Discover</h3><p>Understand the context, constraints, and possible connections.</p></li><li><span>03</span><h3>Qualify</h3><p>Review fit, scope, and the details that require confirmation.</p></li><li><span>04</span><h3>Coordinate</h3><p>Define responsibilities and an agreed path forward.</p></li><li><span>05</span><h3>Deliver</h3><p>Work toward the outcome within the confirmed engagement.</p></li></ol></div></section>
<section class="section section-dark government-feature"><div class="wrap government-grid"><div><p class="eyebrow">04 / GOVERNMENT & PUBLIC SECTOR</p><h2>Public requirements.<br/><span>A clear point of entry.</span></h2><p>For federal, state, local, and other public-sector buyers: start with the opportunity, the acquisition path, or the requirement.</p><div class="actions"><a class="button" href="/request?type=government">Submit Government Requirement <span aria-hidden="true">↗</span></a><a class="text-link" href="/government">Explore Government ↗</a></div></div><div class="government-panel"><span class="eyebrow">KORA BUSINESS SOLUTIONS</span><h3>Government<br/>Registered<br/>Supplier<span class="signal-dot"></span></h3><p>{contacts.location}</p><div><a href={`mailto:${contacts.procurement}`}>Contact Procurement <span aria-hidden="true">↗</span></a><a href={`mailto:${contacts.contracts}`}>Contact Contracts <span aria-hidden="true">↗</span></a></div></div></div></section>
<section class="section"><div class="wrap partner-feature"><div><p class="eyebrow">05 / BETTER CONNECTIONS</p><h2>Bring your capability.<br/>Explore the connection.</h2></div><div class="partner-paths"><a href="/partners/suppliers"><span class="eyebrow">SUPPLIERS & MANUFACTURERS</span><h3>A place to introduce<br/>what you do. <span aria-hidden="true">↗</span></h3></a><a href="/partners/teaming"><span class="eyebrow">TEAMING & DELIVERY PARTNERS</span><h3>Start a partnership<br/>conversation. <span aria-hidden="true">↗</span></h3></a></div></div></section><FinalCTA/>
</SiteLayout>
<style>.home-hero{background:var(--ink);color:var(--paper);overflow:hidden}.hero-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:45px;padding-top:76px;padding-bottom:66px;align-items:center}.hero-copy h1{font-size:clamp(4.6rem,7.4vw,8rem);line-height:.98;letter-spacing:-.065em;margin-bottom:28px}.hero-copy h1>span{color:var(--signal)}.hero-copy .section-label{font-size:9px;letter-spacing:1.65px;margin-bottom:34px}.hero-copy>p{max-width:470px;font-size:17px;color:#b8bbb1;line-height:1.65}.hero-copy .actions{gap:27px;margin-top:33px}.hero-secondary{font-size:12px;min-height:44px;display:flex;gap:18px;align-items:center;border-bottom:1px solid #6d7065}.hero-government{display:flex;align-items:center;gap:11px;font-size:10px;letter-spacing:.2px;margin-top:42px;min-height:44px;width:fit-content}.hero-government>.signal-dot{background:var(--sage);width:5px;height:5px}.hero-government>span:last-child{margin-left:15px}.hero-art{position:relative;border:1px solid #41443b;background:#1b1e17;padding:18px 18px 16px;transform:rotate(-3deg);max-width:540px;margin-left:auto;width:100%}.hero-art svg{display:block;width:100%;height:auto;margin:18px 0 12px}.art-top,.art-bottom{font-size:7px;letter-spacing:1.2px;color:#c3c7b8;display:flex;justify-content:space-between;gap:15px}.hero-baseline{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #3a3d33;padding-top:20px;padding-bottom:20px;gap:20px;color:#a9ad9f;font-size:9px;letter-spacing:1px}.hero-baseline a{display:flex;min-height:44px;align-items:center;gap:24px;color:var(--paper);font-size:10px;letter-spacing:0}.launcher-section{padding:65px 0;background:var(--stone);border-bottom:1px solid var(--line)}.launcher-heading{display:grid;grid-template-columns:.7fr 1.2fr 1fr;align-items:start;gap:45px;margin-bottom:36px}.launcher-heading .eyebrow{font-size:9px;margin-top:6px}.launcher-heading h2{font-size:35px;margin:0}.launcher-heading>p:last-child{font-size:14px;color:var(--muted);margin-top:4px}.launcher-grid{display:grid;grid-template-columns:repeat(4,1fr);border-left:1px solid #cbcec1;border-top:1px solid #cbcec1}.launcher-grid a{display:grid;grid-template-columns:1fr 20px;gap:22px 10px;border-bottom:1px solid #cbcec1;border-right:1px solid #cbcec1;padding:22px;min-height:128px;transition:background .18s}.launcher-grid a:hover{background:#e4e8d9}.launcher-grid a>.eyebrow{grid-column:1/-1;color:var(--muted);font-size:9px}.launcher-grid a>span:nth-child(2){font-size:14px;line-height:1.4;max-width:180px}.launcher-grid a>span:last-child{font-size:20px;align-self:end}.process{display:grid;grid-template-columns:repeat(5,1fr);padding:0;list-style:none;gap:26px;margin:55px 0 0}.process li{position:relative;border-top:1px solid #a2a696;padding-top:25px}.process li::before{position:absolute;content:'';top:-4px;left:0;width:7px;height:7px;background:var(--ink)}.process li:first-child::before{background:#af3218}.process li>span{font-size:11px;color:var(--muted)}.process h3{font-size:22px;margin:20px 0 12px}.process p{font-size:13px;color:var(--muted);max-width:200px}.government-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:100px;align-items:center}.government-grid h2{font-size:clamp(2.5rem,3.8vw,4rem);margin-top:25px}.government-grid h2>span{color:#b9bdaf}.government-grid>div>p:not(.eyebrow){color:#b9bdaf;max-width:520px;font-size:15px}.government-grid .actions{gap:25px}.government-grid .text-link{font-size:12px}.government-panel{border:1px solid #565b4c;padding:32px;background:#20241b}.government-panel>.eyebrow{font-size:9px;color:#b9bdaf}.government-panel h3{font-size:40px;line-height:1.08;letter-spacing:-1.5px;margin:35px 0 25px;position:relative}.government-panel h3 .signal-dot{width:12px;height:12px;margin-left:14px}.government-panel>p{font-size:11px!important}.government-panel>div{margin-top:32px;border-top:1px solid #565b4c}.government-panel a{display:flex;justify-content:space-between;align-items:center;font-size:12px;padding-top:18px;min-height:44px}.partner-feature{display:grid;grid-template-columns:1.1fr 1fr;gap:70px}.partner-feature h2{font-size:clamp(2.5rem,3.3vw,3.6rem)}.partner-paths>a{display:block;padding:0 0 26px;margin-bottom:28px;border-bottom:1px solid var(--line)}.partner-paths .eyebrow{font-size:9px;color:var(--muted)}.partner-paths h3{font-size:27px;margin:17px 0 0}.partner-paths h3 span{float:right}.partner-paths a:hover h3{text-decoration:underline;text-underline-offset:6px}@media(max-width:1099px){.hero-grid{gap:35px;padding-top:60px}.hero-copy h1{font-size:clamp(4rem,8vw,6rem)}.hero-art{padding:12px}.hero-copy .actions{gap:14px}.hero-copy .section-label{font-size:8px;letter-spacing:1px}.hero-copy>p{font-size:16px}.hero-baseline>span:nth-child(2){display:none}.government-grid{gap:40px}.launcher-heading{grid-template-columns:.7fr 1.3fr}.launcher-heading>p:last-child{grid-column:2}.partner-feature{gap:40px}}@media(max-width:767px){.hero-grid{display:block;padding-top:46px;padding-bottom:40px}.hero-copy h1{font-size:clamp(3.9rem,13.5vw,6rem)}.hero-copy .section-label{font-size:8px;letter-spacing:.8px;margin-bottom:26px}.hero-copy>p{font-size:16px;max-width:420px}.hero-copy .actions{gap:20px}.hero-government{margin-top:20px}.hero-art{max-width:380px;margin:40px auto 10px;transform:rotate(-2deg);padding:13px}.hero-art svg{max-height:310px}.hero-baseline{font-size:8px;letter-spacing:.3px;gap:14px}.hero-baseline a{font-size:9px;gap:12px}.launcher-section{padding:48px 0}.launcher-heading{display:block}.launcher-heading h2{font-size:32px;margin:22px 0 18px}.launcher-heading>p:last-child{font-size:14px}.launcher-grid{grid-template-columns:repeat(2,1fr)}.launcher-grid a{padding:16px;gap:18px 8px;min-height:135px}.launcher-grid a>span:nth-child(2){font-size:13px}.process{grid-template-columns:1fr;margin-top:36px;gap:0}.process li{display:grid;grid-template-columns:35px 1fr;gap:10px 15px;padding:22px 0}.process li::before{display:none}.process h3{margin:0}.process p{grid-column:2;max-width:none;margin:0}.process li>span{padding-top:5px}.government-grid,.partner-feature{grid-template-columns:1fr;gap:40px}.government-panel{padding:28px}.government-panel h3{font-size:36px}.government-grid h2{font-size:36px}.partner-feature h2{font-size:34px}.partner-paths>a:last-child{margin-bottom:0}.hero-secondary{font-size:12px}.hero-copy .button{font-size:12px;padding:15px 18px;gap:22px}}@media(prefers-reduced-motion:reduce){.hero-art{transform:none}}
</style>
